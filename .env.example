# FF-Agri-Cal-Pro Environment Variables
# Copy this to .env and fill in values

# Database (any standard PostgreSQL URL: local postgres or hosted Neon)
DATABASE_URL=postgresql://user:password@host:5432/database
# Required for normal startup. Set MEM_STORAGE=1 ONLY for tests/demos
# (in-memory storage, nothing persists).
# MEM_STORAGE=1

# Session secret (generate a random string)
SESSION_SECRET=change-this-to-a-random-string

# Assistant model: exactly one model is used for all chat requests.
# There is no automatic fallback; failures surface explicitly.
CHAT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sk-...

# Web research (optional — research tools fail honestly without a key)
PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar
# PERPLEXITY_MAX_TOKENS=2000
# PERPLEXITY_RECENCY=            # leave unset: evergreen agronomy must not be
#                                # biased to recent pages; set day|week|month|year
#                                # only when a query needs fresh results

# Proactive agent (weather/conflict watch). Runs every 6h by default.
# AGENT_WATCH_ENABLED=0          # disable the background watch
# AGENT_WATCH_INTERVAL_MINUTES=360

# Tool loop: max model requests per chat message (default 8)
# TOOL_LOOP_LIMIT=8
# API rate limit: requests per 15 minutes per IP (default 100 in production, 1000 in development)
# RATE_LIMIT_MAX=100

# Weather: Open-Meteo (no API key required)

# Server
PORT=3000
NODE_ENV=development

# CORS (set to your frontend URL in production)
CORS_ORIGIN=http://localhost:5001
